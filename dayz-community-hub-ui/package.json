{
  "name": "dayz-community-hub-ui",
  "version": "0.4.1",
  "description": "Server browser & mod manager for DayZ Standalone",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--disable-warning=DEP0205 vite dev",
    "build": "NODE_OPTIONS=--disable-warning=DEP0205 vite build",
    "preview": "NODE_OPTIONS=--disable-warning=DEP0205 vite preview",
    "check": "NODE_OPTIONS=--disable-warning=DEP0205 svelte-kit sync && NODE_OPTIONS=--disable-warning=DEP0205 svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "NODE_OPTIONS=--disable-warning=DEP0205 svelte-kit sync && NODE_OPTIONS=--disable-warning=DEP0205 svelte-check --tsconfig ./tsconfig.json --watch",
    "fmt:check": "prettier --check src/**/*.{ts,svelte}",
    "fmt": "prettier --write src/**/*.{ts,svelte}",
    "tauri": "NODE_OPTIONS=--disable-warning=DEP0205 tauri",
    "machine-translate": "inlang machine translate --project project.inlang"
  },
  "license": "MIT",
  "dependencies": {
    "@iconify/svelte": "^5.2.2",
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@types/matter-js": "^0.20.2",
    "daisyui": "^5.5.23",
    "matter-js": "^0.20.0",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@inlang/cli": "^3.1.14",
    "@inlang/paraglide-js": "^2.20.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.66.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2.11.3",
    "prettier": "^3.8.4",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
