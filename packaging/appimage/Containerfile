# The Linux release is built in here, not on the dev machine: an AppImage
# carries the libraries it was built against (webkit2gtk, gtk, glib, and
# some 200 more), and those ask for the glibc of the system that built
# them. Built on Arch they want Arch's glibc (v0.5.0 needed 2.44, so it only
# ran on a current Arch). Built on Ubuntu 22.04 they want 2.35, and so does
# the binary: every mainstream distribution since 2022 runs it. 22.04 is the
# oldest release that ships webkit2gtk-4.1, which Tauri 2 needs.
#
# Built and run by scripts/appimage.sh; see docs/build.md.
FROM docker.io/library/ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
# Tauri's Linux dependencies, libudev (gilrs), zstd (pkg-config), perl
# (vendored OpenSSL), and file/patchelf/squashfs for linuxdeploy.
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential ca-certificates curl wget file git pkg-config perl \
      patchelf squashfs-tools xdg-utils desktop-file-utils \
      libwebkit2gtk-4.1-dev libgtk-3-dev libayatana-appindicator3-dev \
      librsvg2-dev libssl-dev libudev-dev libzstd-dev libxdo-dev \
    && rm -rf /var/lib/apt/lists/*

# Rust: rustup only. The toolchain itself is the one rust-toolchain.toml
# names, installed on first use into the volume scripts/appimage.sh mounts.
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain none \
    && mkdir -m 1777 /home/builder

ARG BUN_VERSION=1.4.2
COPY --from=docker.io/oven/bun:${BUN_VERSION} /usr/local/bin/bun /usr/local/bin/bun
