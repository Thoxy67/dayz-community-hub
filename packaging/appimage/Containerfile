# The Linux release is built in here, not on the dev machine, so the
# executable asks for the glibc of Ubuntu 22.04 (2.35) and not the build
# machine's: every mainstream distribution since 2022 runs it. (v0.5.0, built
# on Arch, needed glibc 2.44 and ran on a current Arch only.)
#
# The egui window carries no library: wgpu loads Vulkan or OpenGL, winit
# loads Wayland, X11 and xkbcommon, all with dlopen from the host, which must
# be the host's own (they talk to its drivers and its compositor). So the
# AppImage is the executable, its .desktop, icons and MIME file, and AppRun.
#
# Built and run by scripts/appimage.sh, which runs packaging/appimage/build.sh
# in here; see docs/build.md.
FROM docker.io/library/ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
# A C toolchain and perl (vendored OpenSSL, aws-lc-sys), libudev (gilrs, the
# controllers), zstd (linked through pkg-config), and what appimagetool runs:
# file, squashfs-tools, desktop-file-utils (it validates the .desktop).
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential ca-certificates curl file git pkg-config perl \
      squashfs-tools desktop-file-utils \
      libudev-dev libzstd-dev \
    && rm -rf /var/lib/apt/lists/*

# Rust: rustup only. The toolchain itself is the one rust-toolchain.toml
# names, installed on first use into the volume scripts/appimage.sh mounts.
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain none \
    && mkdir -m 1777 /home/builder

# appimagetool and the static type 2 runtime it puts in front of the image
# (no libfuse2 needed on the user's machine), pinned by version and checksum:
# without --runtime-file, appimagetool would download whatever runtime is
# current at every build. appimagetool is itself an AppImage: extracted here,
# since a container has no FUSE.
ARG APPIMAGETOOL_VERSION=1.9.1
ARG APPIMAGETOOL_SHA256=ed4ce84f0d9caff66f50bcca6ff6f35aae54ce8135408b3fa33abfc3cb384eb0
ARG RUNTIME_VERSION=20251108
ARG RUNTIME_SHA256=2fca8b443c92510f1483a883f60061ad09b46b978b2631c807cd873a47ec260d
RUN mkdir -p /opt/appimage && cd /opt/appimage \
    && curl -sSfL -o appimagetool.AppImage \
         "https://github.com/AppImage/appimagetool/releases/download/${APPIMAGETOOL_VERSION}/appimagetool-x86_64.AppImage" \
    && echo "${APPIMAGETOOL_SHA256}  appimagetool.AppImage" | sha256sum -c - \
    && curl -sSfL -o runtime-x86_64 \
         "https://github.com/AppImage/type2-runtime/releases/download/${RUNTIME_VERSION}/runtime-x86_64" \
    && echo "${RUNTIME_SHA256}  runtime-x86_64" | sha256sum -c - \
    && chmod +x appimagetool.AppImage \
    && ./appimagetool.AppImage --appimage-extract >/dev/null \
    && mv squashfs-root appimagetool && rm appimagetool.AppImage \
    && ln -s /opt/appimage/appimagetool/AppRun /usr/local/bin/appimagetool
