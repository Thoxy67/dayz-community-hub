# Maintainer: thoxy <thi.hur67@gmail.com>
#
# Generated by `make aur` from packaging/aur/PKGBUILD.in in
# https://git.thoxy.xyz/thoxy/dayz-community-hub — edit it there, not here.
pkgname=dayz-community-hub-git
pkgver=@PKGVER@
pkgrel=1
pkgdesc="DayZ launcher: server browser, mod manager and offline mode"
arch=('x86_64')
url="https://git.thoxy.xyz/thoxy/dayz-community-hub"
license=('MIT')
depends=(
    'webkit2gtk-4.1'
    'gtk3'
    'libayatana-appindicator'
    'openssl'
    'zstd'
)
# `cargo` is provided by both `rust` and `rustup`; with rustup, the version
# pinned in rust-toolchain.toml is installed on the first build. aws-lc-sys
# (the TLS used for dayz.com news) needs cmake and nasm to compile.
makedepends=(
    'cargo'
    'bun'
    'git'
    'python'
    'cmake'
    'nasm'
    'clang'
)
provides=('dayz-community-hub')
conflicts=('dayz-community-hub')
# makepkg's C/C++ LTO turns aws-lc-sys's objects into bitcode the final link
# cannot resolve. Rust's own LTO (the Cargo release profile) is unaffected.
options=(!lto)
source=("$pkgname::git+https://git.thoxy.xyz/thoxy/dayz-community-hub.git#branch=master")
sha256sums=('SKIP')

pkgver() {
    cd "$pkgname"
    local ver
    ver="$(python3 -c "import json; print(json.load(open('apps/gui/src-tauri/tauri.conf.json'))['version'])")"
    printf "%s.r%s.g%s" "$ver" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
    cd "$pkgname"
    export CARGO_HOME="$srcdir/cargo-home"
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
    cd apps/gui
    bun install --frozen-lockfile
}

build() {
    cd "$pkgname/apps/gui"
    export CARGO_HOME="$srcdir/cargo-home"
    export CARGO_TARGET_DIR="$srcdir/$pkgname/target"
    # No updater artefacts and no bundles: pacman owns this installation, and
    # the in-app updater only ever replaces an AppImage.
    bun run tauri build --no-bundle
}

package() {
    cd "$pkgname"

    install -Dm755 "target/release/dayz-community-hub" "$pkgdir/usr/bin/dayz-community-hub"

    local icons=apps/gui/src-tauri/icons
    install -Dm644 "$icons/32x32.png" "$pkgdir/usr/share/icons/hicolor/32x32/apps/dayz-community-hub.png"
    install -Dm644 "$icons/64x64.png" "$pkgdir/usr/share/icons/hicolor/64x64/apps/dayz-community-hub.png"
    install -Dm644 "$icons/128x128.png" "$pkgdir/usr/share/icons/hicolor/128x128/apps/dayz-community-hub.png"
    install -Dm644 "$icons/128x128@2x.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/dayz-community-hub.png"

    install -Dm644 apps/gui/src-tauri/assets/linux/dayz-community-hub.desktop \
        "$pkgdir/usr/share/applications/dayz-community-hub.desktop"

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
