# Maintainer: thoxy <thi.hur67@gmail.com>
#
# Generated by `make aur` from packaging/aur/PKGBUILD.in in
# https://git.thoxy.xyz/thoxy/dayz-community-hub — edit it there, not here.
pkgname=dayz-community-hub-git
pkgver=@PKGVER@
pkgrel=1
pkgdesc="DayZ launcher: server browser, mod manager and offline mode"
arch=('x86_64')
url="https://git.thoxy.xyz/thoxy/dayz-community-hub"
license=('MIT')
# The executable links only glibc, libgcc, zstd and libudev (ldd). The rest is
# loaded with dlopen at run time: keyboard maps (libxkbcommon) and OpenGL/EGL
# (libglvnd) always, Vulkan when there is a driver for it, Wayland or X11 for
# the session the window opens on. File dialogs go through the desktop portal.
# There is no web view any more, so none of its toolkit either.
depends=(
    'zstd'
    # libudev, for the controllers (gilrs)
    'systemd-libs'
    'libxkbcommon'
    'libglvnd'
    'hicolor-icon-theme'
)
optdepends=(
    'vulkan-icd-loader: the Vulkan renderer (OpenGL is used otherwise)'
    'wayland: a Wayland session'
    'libxcursor: an X11 session'
    'libxrandr: an X11 session'
    'libxi: an X11 session'
    'xdg-desktop-portal: file and folder dialogs'
)
# `cargo` is provided by both `rust` and `rustup`; with rustup, the version
# pinned in rust-toolchain.toml is installed on the first build. aws-lc-sys
# (the TLS used for dayz.com news) needs cmake and nasm to compile; OpenSSL is
# vendored (built from source, perl).
makedepends=(
    'cargo'
    'git'
    'python'
    'cmake'
    'nasm'
    'clang'
    'perl'
)
provides=('dayz-community-hub')
conflicts=('dayz-community-hub')
# makepkg's C/C++ LTO turns aws-lc-sys's objects into bitcode the final link
# cannot resolve. Rust's own LTO (the Cargo release profile) is unaffected.
options=(!lto)
source=("$pkgname::git+https://git.thoxy.xyz/thoxy/dayz-community-hub.git#branch=master")
sha256sums=('SKIP')

pkgver() {
    cd "$pkgname"
    local ver
    ver="$(python3 -c "import tomllib; print(tomllib.load(open('Cargo.toml', 'rb'))['workspace']['package']['version'])")"
    printf "%s.r%s.g%s" "${ver//-/_}" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
    cd "$pkgname"
    export CARGO_HOME="$srcdir/cargo-home"
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$pkgname"
    export CARGO_HOME="$srcdir/cargo-home"
    export CARGO_TARGET_DIR="$srcdir/$pkgname/target"
    # aws-lc-sys compiles its jitter entropy source at -O0, which it requires
    # (#error otherwise), but makepkg's CFLAGS (-O2, or -O3 on CachyOS) come
    # after its own flags and win. That source is an extra one on top of the
    # system's getrandom, which stays: leave it out.
    export AWS_LC_SYS_NO_JITTER_ENTROPY=1
    # The egui window, under the launcher's name. pacman owns this
    # installation: the in-app updater only ever replaces an AppImage or the
    # Windows executable, and here it declines with a reason.
    cargo build --frozen --release -p dayz-community-hub --bin dayz-community-hub
}

package() {
    cd "$pkgname"

    install -Dm755 "target/release/dayz-community-hub" "$pkgdir/usr/bin/dayz-community-hub"

    local size
    for size in 32 64 128 256; do
        install -Dm644 "apps/desktop/assets/app/icon-$size.png" \
            "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/dayz-community-hub.png"
    done

    install -Dm644 packaging/linux/dayz-community-hub.desktop \
        "$pkgdir/usr/share/applications/dayz-community-hub.desktop"
    install -Dm644 packaging/linux/dayz-community-hub.xml \
        "$pkgdir/usr/share/mime/packages/dayz-community-hub.xml"

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
