# Copy this file to .env and fill in your values.
# .env is gitignored — never commit secrets.

# Tauri updater signing key (raw content of the .key file, including the header lines).
# Generate with: minisign -G -s ~/.tauri/yourapp.key -p ~/.tauri/yourapp.pub
# Then: cat ~/.tauri/yourapp.key
TAURI_SIGNING_PRIVATE_KEY=

# Leave empty if the key has no password.
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Forgejo personal access token.
# Create at: https://git.thoxy.xyz/user/settings/applications
# Required scopes: write:repository, write:release
FORGEJO_TOKEN=
