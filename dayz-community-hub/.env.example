# Copy this file to .env and fill in your values.
# .env is gitignored — never commit secrets.

# Path to the minisign private key file.
# Default is ~/.tauri/dayz-community-hub.key — only set this if yours is elsewhere.
# TAURI_SIGNING_KEY_FILE=~/.tauri/dayz-community-hub.key

# Leave empty if the key has no password.
TAURI_SIGNING_KEY_PASS=

# Forgejo personal access token.
# Create at: https://git.thoxy.xyz/user/settings/applications
# Required scopes: write:repository, write:release
FORGEJO_TOKEN=
