{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DayZ Community Hub",
  "version": "0.2.3",
  "identifier": "com.thoxy.dayz-community-hub",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "DayZ-SA Multi Launcher",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "assets/linux/dayz-community-hub.desktop"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVDNTVGRDBERUNCRDVCRDUKUldUVlc3M3NEZjFWN0RKRVRJTDFGMENobGlOdDljK2V2ZTZwTkx4VitvMVoyb0JOakZEUTlhUkYK",
      "dangerousInsecureTransportProtocol": false,
      "endpoints": [
        "https://git.thoxy.xyz/thoxy/dayz-community-hub/releases/download/latest/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
