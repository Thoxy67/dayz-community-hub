# Copy this file to .env (at the repository root) and fill in your values.
# `dzch release` / `make publish` read it after the environment and before
# ~/.config/dayz-community-hub/ (see docs/build.md). .env is git-ignored:
# never commit secrets.

# Path to the minisign private key file (required).
TAURI_SIGNING_KEY_FILE=/path/to/signing-keys/dayz-community-hub.key

# Key password — leave empty if the key has no password.
TAURI_SIGNING_KEY_PASS=

# Forgejo personal access token.
# Create at: https://git.thoxy.xyz/user/settings/applications
# Required scopes: write:repository, write:release
FORGEJO_TOKEN=
