{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node", "unplugin-icons/types/svelte"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "paths": {
      "$lib/*": ["./src/lib/*"],
      "$features/*": ["./src/features/*"],
      "$shell/*": ["./src/shell/*"],
      "$content/*": ["./src/content/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "*.config.ts", "*.config.js", ".intlayer/types/**/*.ts"]
}
