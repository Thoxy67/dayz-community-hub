{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "news-webview",
  "description": "The hidden dayz.com window runs remote content: it may only hand the news JSON back, nothing else.",
  "windows": [
    "news-fetch"
  ],
  "remote": {
    "urls": [
      "https://dayz.com",
      "https://*.dayz.com"
    ]
  },
  "permissions": [
    "allow-news-webview-result"
  ]
}
